# Copie para .env e ajuste. Nunca publique o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Se acessar por domínio/HTTPS, informe a origem completa, ex.: https://motel.exemplo.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0

POSTGRES_DB=motel
POSTGRES_USER=motel
POSTGRES_PASSWORD=troque-esta-senha

# Porta no computador
WEB_PORT=8000

# Usuário criado na primeira execução
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# 0 = não criar a empresa de exemplo
DEMO_DATA=1
